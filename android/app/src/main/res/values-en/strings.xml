    <string name="mmd_body">Play body motion</string>
    <string name="mmd_body_hint">Plays the work\'s body motion, on by default; MMD must also be enabled. Disabling keeps the work camera and audio.</string>
    <string name="mmd_face">Play face motion</string>
    <string name="mmd_face_hint">Uses the work\'s facial expressions, on by default. Playback support depends on the overlay status.</string>
    <string name="mmd_motion_scale">Motion displacement scale (0.05–5)</string>
    <string name="mmd_terrain">Terrain follow</string>
    <string name="mmd_terrain_hint">Lets body motion follow ground height, off by default; requires a usable terrain interface, and the actual capability depends on the game state.</string>
    <string name="mmd_cloth_mode">Cloth mode</string>
    <string name="mmd_cloth_game">Game mode</string>
    <string name="mmd_cloth_stable">Stable mode (default)</string>
    <string name="mmd_cloth_freeze">Frozen mode</string>
    <string name="mmd_cloth_hint">Game mode keeps the original cloth simulation, stable mode favors stable playback and frozen mode locks the cloth; support depends on the current character.</string>
    <string name="camera_advanced_title">Camera moves &amp; keyframes</string>
    <string name="camera_advanced_hint">Enable the free camera in the main settings, then start camera moves or keyframe playback from the in-game overlay. Values here save automatically and load after a game restart.</string>
