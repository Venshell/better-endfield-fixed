    <string name="voice_list_caption">Language rules for all characters</string>
    <string name="settings_description">Choose Chinese, English, Japanese, Korean or follow the game for each character. The character and voice-filler table comes from the desktop legacy table; the resident catalog is generated from the phone\'s own language pack the next time the game starts.</string>
    <string name="voice_table_ready">Desktop legacy table loaded: %1$d characters, %2$d character/language catalogs.</string>
