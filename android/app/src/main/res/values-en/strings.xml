    <string name="current_setting_ready">Changes save automatically; text saves when editing stops and refreshes when you leave the page. Configuration loads after the game is force-stopped and restarted; running actions are triggered from the overlay.</string>
    <string name="restart_required">Settings saved. Force-stop and restart the game; the phone-specific catalog is generated the first time the new voice rules are used.</string>
    <string name="model_restart_required">Model settings saved. Force-stop and restart the game.</string>
    <string name="enhancement_description">Interface, sustained dash and camera enhancements are configured here. Actions that must fire while the game is running live in the overlay; every other switch is on this page.</string>
    <string name="ui_card_eyebrow">INTERFACE · betterendfieldnext.ui</string>
    <string name="ui_card_title">Touch &amp; UI Enhancements</string>
    <string name="ui_card_subtitle">Compiled from the same source as the desktop build. Hiding the UID is a persistent switch; hiding the whole HUD must be toggled in-game, so the switch is here and the trigger is in the overlay.</string>
    <string name="ui_hide_uid">Hide UID watermark</string>
    <string name="ui_hide_uid_hint">Hides the account UID watermark from game rendering and re-scans existing panels every 2 seconds.</string>
    <string name="ui_hide_hud">Allow hiding the whole HUD</string>
    <string name="ui_hide_hud_hint">Hides or restores every HUD canvas under MainHudRoot without affecting menus or settings. Toggled from the overlay button.</string>
    <string name="camera_card_eyebrow">CAMERA · betterendfieldnext.camera</string>
    <string name="camera_card_title">Camera enhancements</string>
    <string name="camera_card_subtitle">Free camera, world time freeze and MMD are enabled separately and triggered from the overlay while playing; the switches and values here save automatically and load after a game restart.</string>
    <string name="camera_dither">Disable character mesh dither</string>
    <string name="camera_dither_hint">Invokes the game\'s own ForceClearDither to remove the translucency when the camera is close to a character. No hotkey needed.</string>
    <string name="camera_free">Enable free camera</string>
    <string name="camera_free_hint">Captures the main camera position and field of view on entry and restores them on exit. Direction and elevation keys appear when the overlay is expanded.</string>
    <string name="camera_pause">Enable world time freeze</string>
    <string name="camera_pause_hint">Freezes game time. Independent of the other features; freeze or resume from the overlay.</string>
    <string name="camera_hide_head_hint">Hides the head with a separate mesh copy, keeping the body, arms and original shadows.</string>
    <string name="camera_fill_neck_hint">Hiding the head exposes the neck opening; a small patch covers it.</string>
    <string name="camera_group_values">Values</string>
    <string name="camera_speed_label">Movement speed</string>
    <string name="camera_fov_label">Field of view (FOV)</string>
    <string name="dash_card_eyebrow">SPRINT · betterendfieldnext.actions</string>
    <string name="dash_card_title">Sustained Dash</string>
    <string name="dash_card_subtitle">Plays a character\'s special dash action continuously. The loop segment is driven by bone pose data shipped with the module; the desktop build uses no hotkey, so this page holds every setting.</string>
    <string name="dash_enable">Enable sustained dash</string>
    <string name="dash_enable_hint">Preserves the left or right special dash chosen by the game and repeats it while sprinting, deferring natural completion. Stops on movement end or interruption.</string>
    <string name="dash_group_characters">Characters</string>
    <string name="dash_aglina">Gilberta</string>
    <string name="dash_aglina_hint">Continues the sprint_dash_sp effect and re-ignites the 3-second highlight.</string>
    <string name="dash_liino">Reno</string>
    <string name="dash_liino_hint">Keeps the skateboard and weapon trail, deferring the game\'s 2.2-second cleanup.</string>
    <string name="dash_group_options">Options</string>
    <string name="dash_pose_note">The loop segment uses bone pose data shipped with the module and the animation is driven by %1$s; the native action and movement logic stay unchanged.</string>
    <string name="dash_liino_clean">Hide mech and effects</string>
    <string name="dash_liino_clean_hint">Hides Reno\'s mech, including leg armor, and effects throughout her dash while keeping the flight animation.</string>
    <string name="dash_jsspsi">Si</string>
    <string name="dash_jsspsi_quality">High-quality transition</string>
    <string name="dash_jsspsi_quality_hint">Fixes the tail and back-hair swing and the body snap at each rewind. Rewrites about 400 bones every frame, so the per-frame cost is clearly higher than the other options; switch it off if the frame rate drops.</string>
    <string name="overlay_card_eyebrow">IN-GAME PANEL</string>
    <string name="overlay_card_title">Overlay</string>
    <string name="overlay_card_subtitle">A draggable icon inside the game that opens the actions which otherwise need hotkeys. No system overlay permission and no background service required.</string>
    <string name="overlay_enable">Show the overlay in game</string>
    <string name="overlay_enable_hint">Restart the game after enabling it for the first time. The panel follows the game screen.</string>
    <string name="overlay_preview">Preview the overlay</string>
    <string name="overlay_preview_hint">Inspect the panel appearance and layout locally without injecting the game.</string>
