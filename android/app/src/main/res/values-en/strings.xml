    <string name="mmd_enable_hint">Plays imported works with motion, face, camera and audio. Saves automatically and loads after a game restart; playback and status live in the in-game overlay.</string>
    <string name="mmd_manage">MMD / advanced camera moves / import work</string>
    <string name="mmd_description">Choose a work folder containing set.ini and the files it references. Files are copied into the app and published so the game can read them. Imports and settings save automatically and load after a game restart; the overlay status is authoritative for playback.</string>
