[Unit]
Description=Backup EF Link account database

[Service]
Type=oneshot
User=eflink
Group=eflink
WorkingDirectory=/opt/eflink
Environment=EFLINK_AUTH_DB=/var/lib/eflink/accounts.sqlite
Environment=EFLINK_BACKUP_DIR=/var/lib/eflink/backups
Environment=EFLINK_BACKUP_KEEP=28
ExecStart=/usr/bin/python3 /opt/eflink/backup_accounts.py
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/eflink
